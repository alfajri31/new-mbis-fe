<?xml version="1.0" encoding="utf-8"?>
<!--
  Konfigurasi DASAR — inilah yang dipakai build prod-release: semua trafik wajib
  HTTPS, tanpa kecuali.

  Pengecualian cleartext untuk backend lokal (10.0.2.2 / localhost) TIDAK lagi ada
  di sini; ia dipindahkan ke source set `debug` dan flavor `staging` supaya tidak
  pernah ikut terbawa ke AAB produksi:
    - android/app/src/debug/res/xml/network_security_config.xml
    - android/app/src/staging/res/xml/network_security_config.xml
  Gradle menimpa resource bernama sama dari flavor/buildType di atas `main`.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
