<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) menggantikan android:fullBackupContent dengan aturan ini.
  Data aplikasi berisi token sesi & PII, jadi cloud-backup dan transfer antar-
  perangkat dinonaktifkan total supaya data tidak bisa diekstrak lewat backup.
  android:allowBackup="false" di manifest menangani perangkat < API 31.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
